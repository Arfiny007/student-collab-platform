# Server (NestJS) — copy to .env for local dev or set in Render/Railway

PORT=5000
NODE_ENV=development

# PostgreSQL (Neon, Railway, or Docker `db` service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_collab
# Or discrete vars:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=student_collab

JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed browser origins (Vercel URL, local dev, etc.)
CLIENT_URL=http://localhost:3000,http://localhost:3001
